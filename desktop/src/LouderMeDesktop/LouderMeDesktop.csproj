<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LouderMe</AssemblyName>
    <RootNamespace>LouderMeDesktop</RootNamespace>
    <Version>0.1.17</Version>
    <AssemblyVersion>0.1.17.0</AssemblyVersion>
    <FileVersion>0.1.17.0</FileVersion>
    <Product>LouderMe Desktop</Product>
    <Company>Michel's Lab</Company>
    <Authors>Michel Armando Duarte Flores</Authors>
    <Description>Native Windows audio control companion for LouderMe.</Description>
    <ApplicationIcon Condition="Exists('Assets\LouderMe.ico')">Assets\LouderMe.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\LouderMeOfficialDarkLockup.png" LogicalName="LouderMeDesktop.Assets.LouderMeOfficialDarkLockup.png" />
    <EmbeddedResource Include="Assets\LouderMeOfficialLockup.png" LogicalName="LouderMeDesktop.Assets.LouderMeOfficialLockup.png" />
    <EmbeddedResource Include="Assets\LouderMe.ico" LogicalName="LouderMeDesktop.Assets.LouderMe.ico" />
    <EmbeddedResource Include="Assets\MichelDuarte.jpg" LogicalName="LouderMeDesktop.Assets.MichelDuarte.jpg" />
    <EmbeddedResource Include="Assets\MichelsLabMark.png" LogicalName="LouderMeDesktop.Assets.MichelsLabMark.png" />
    <EmbeddedResource Include="Assets\MichelsLabCanonicalLockup.png" LogicalName="LouderMeDesktop.Assets.MichelsLabCanonicalLockup.png" />
    <EmbeddedResource Include="Assets\MichelsLabDarkLockup.png" LogicalName="LouderMeDesktop.Assets.MichelsLabDarkLockup.png" />
  </ItemGroup>
</Project>
